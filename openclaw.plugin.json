{
  "id": "seo-google-suite",
  "name": "SEO Google Suite",
  "description": "Connect Google Search Console, GA4, and CrUX to SEO audits via MCP.",
  "version": "0.1.5",
  "activation": {
    "onStartup": false
  },
  "setup": {
    "providers": [
      {
        "id": "google_search_console",
        "envVars": ["GOOGLE_SERVICE_ACCOUNT_FILE"],
        "authEvidence": [
          {
            "type": "local-file-with-env",
            "fileEnvVar": "GOOGLE_SERVICE_ACCOUNT_FILE",
            "credentialMarker": "gsc-service-account-found",
            "source": "GSC service account JSON"
          }
        ]
      },
      {
        "id": "google_analytics",
        "envVars": ["GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_PROJECT_ID"],
        "authEvidence": [
          {
            "type": "local-file-with-env",
            "fileEnvVar": "GOOGLE_APPLICATION_CREDENTIALS",
            "credentialMarker": "ga4-credentials-found",
            "source": "GA4 OAuth credentials JSON"
          }
        ]
      }
    ],
    "requiresRuntime": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "mcpServers": {
    "google_search_console": {
      "transport": "stdio",
      "command": "gsc-mcp",
      "env": { "GOOGLE_SERVICE_ACCOUNT_FILE": "${GOOGLE_SERVICE_ACCOUNT_FILE}" }
    },
    "google_analytics": {
      "transport": "stdio",
      "command": "analytics-mcp",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}"
      }
    }
  },
  "contracts": {
    "tools": []
  },
  "uiHints": {}
}
